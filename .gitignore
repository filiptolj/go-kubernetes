# Programs built with `go build -o bin/ ./cmd/...`
bin/

# Programs built with a plain `go build ./cmd/<name>`, which puts them here
/apiserver
/controller-manager
/kubelet
/minik8s
/minikubectl
/proxy
/scheduler

# The cluster state the API server saves by default
data/

# Temporary files the file backend writes before renaming them
*.tmp

# Editors and operating systems
.vscode/
.idea/
.DS_Store

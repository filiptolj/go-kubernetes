{
  "kind": "Pod",
  "name": "shared-volume",
  "volumes": [
    { "name": "html", "emptyDir": {} }
  ],
  "containers": [
    {
      "name": "writer",
      "image": "busybox:1.36",
      "command": ["sh", "-c", "while true; do echo \"<h1>Written by the writer container at $(date +%T)</h1>\" > /html/index.html; sleep 5; done"],
      "volumeMounts": [{ "name": "html", "mountPath": "/html" }]
    },
    {
      "name": "web",
      "image": "nginx:1.27",
      "port": 80,
      "volumeMounts": [{ "name": "html", "mountPath": "/usr/share/nginx/html", "readOnly": true }]
    }
  ]
}

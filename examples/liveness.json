{
  "kind": "Pod",
  "name": "unhealthy",
  "containers": [
    {
      "name": "web",
      "image": "nginx:1.27",
      "port": 80,
      "livenessProbe": {
        "httpGet": { "path": "/healthz" },
        "initialDelaySeconds": 3,
        "periodSeconds": 3,
        "failureThreshold": 2
      }
    }
  ]
}
